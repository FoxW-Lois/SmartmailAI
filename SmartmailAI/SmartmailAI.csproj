<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <!-- General Properties -->
        <OutputType Condition="'$(Configuration)' != 'Release'">Exe</OutputType><!-- Console App -->
        <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType><!-- Windows App -->
        <Title>SmartmailAI App</Title>
        <ApplicationIcon Condition="'$(Configuration)'=='Debug'">Assets\Debug\Icon.ico</ApplicationIcon>
        <ApplicationIcon Condition="'$(Configuration)'=='Release'">Assets\Release\Icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Configurations>Debug;Release</Configurations>
        <RootNamespace>SmartmailAI</RootNamespace>
        <!-- Assembly Info Properties -->
        <!-- Note: For some reasons, AssemblyName attribution will cause unknown issues in AppNotificationManager.Default.Register() -->
        <!--<AssemblyName>$(Title)</AssemblyName>-->
        <AssemblyTitle>$(Title)</AssemblyTitle>
        <ProductName>$(Title)</ProductName>
        <Product>$(AssemblyName)</Product>
        <Description>Projet de Boîte mail incluant des outils d'IA pour le module Startup&amp;IT en E5 ; avec WinUI 3 et .NET 9.</Description>
        <Company>$(Title) Team</Company>
        <Authors>$(Company). FoxW-Lois.</Authors>
        <Copyright>Copyright © 2025-2026 $(Company)</Copyright>
        <!-- Package Properties -->
        <PackageIcon Condition="'$(Configuration)'=='Debug'">Assets\Debug\PackageIcon.png</PackageIcon>
        <PackageIcon Condition="'$(Configuration)'=='Release'">Assets\Release\PackageIcon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NeutralLanguage>en</NeutralLanguage>
        <!-- Versioning -->
        <Version>3.0.0</Version>
        <!-- Target Settings -->
        <Platforms>x86;x64;arm64</Platforms>
        <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <!-- WinUI Properties -->
        <UseWinUI>true</UseWinUI>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <!-- AOT Settings -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Other Settings -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableMsixTooling>true</EnableMsixTooling>
        <LangVersion>preview</LangVersion>
        <!-- Custom Settings -->
        <DefineConstants>DISABLE_XAML_GENERATED_MAIN;$(DefineConstants)</DefineConstants><!-- Custom Program -->
        <DefineConstants>SINGLE_INSTANCE;$(DefineConstants)</DefineConstants><!-- Single Instance -->
        <DefineConstants>TRAY_ICON;$(DefineConstants)</DefineConstants><!-- Tray Icon -->
        <DefineConstants>SPLASH_SCREEN;$(DefineConstants)</DefineConstants><!-- Splash Screen -->
        <DefaultLanguage>fr-FR</DefaultLanguage>
        <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
        <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
        <PackageCertificateKeyFile>SmartmailAI_TemporaryKey.pfx</PackageCertificateKeyFile>
        <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
        <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
        <GenerateTestArtifacts>True</GenerateTestArtifacts>
        <AppxBundle>Never</AppxBundle>
        <AppxBundlePlatforms>x64</AppxBundlePlatforms>
        <UserSecretsId>1b801b3c-776e-403d-8eba-881067437401</UserSecretsId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildingInsideVisualStudio)'!='True'">
        <PublishProfile>Properties\PublishProfiles\win-$(Platform).pubxml</PublishProfile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

    <!-- To build with the correct logo assets, only include the ones for the current configuration.
             Place them in a common location, so references to them don't need to adjust for configuration. -->
    <ItemGroup>
        <Content Remove="Assets\Debug\*" />
        <Content Remove="Assets\Release\*" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)'=='Debug'">
        <Content Include="Assets\Debug\**" Link="Assets\Logos\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
        <Content Include="Assets\Debug\Icon.ico" Link="Assets\Icon.ico" CopyToOutputDirectory="Always" />
        <AppxManifest Include="Package_Debug.appxmanifest">
            <SubType>Designer</SubType>
        </AppxManifest>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)'=='Release'">
        <Content Include="Assets\Release\**" Link="Assets\Logos\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
        <Content Include="Assets\Release\Icon.ico" Link="Assets\Icon.ico" CopyToOutputDirectory="Always" />
        <AppxManifest Include="Package.appxmanifest">
            <SubType>Designer</SubType>
        </AppxManifest>
    </ItemGroup>
	
    <ItemGroup>
        <None Remove="NativeMethods.txt" />
        <None Remove="SmartmailDB.db" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="NativeMethods.txt" />
    </ItemGroup>

    <ItemGroup>
			<Content Include="SmartmailDB.db">
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</Content>
    </ItemGroup>

    <ItemGroup>
			<None Update="appsettings.json">
				<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			</None>
		</ItemGroup>
	
		<ItemGroup>
			<None Update="Prompt-system-Smartmail.txt">
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
		</ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
        <PackageReference Include="CommunityToolkit.WinUI.UI.Controls" Version="7.1.2" />
        <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
        <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
        <PackageReference Include="WinUIEx" Version="2.9.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SmartmailAI.Core\SmartmailAI.Core.csproj" />
        <ProjectReference Include="..\SmartmailAI.Infrastructure\SmartmailAI.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>
    
</Project>