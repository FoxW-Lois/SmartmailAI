<Page
	x:Class="SmartmailAI.Views.Pages.EmailList_Page"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="using:SmartmailAI.Behaviors"
	xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:SmartmailAI.Core.Models"
	xmlns:viewmodels="using:SmartmailAI.ViewModels.Pages"
	xmlns:views="using:SmartmailAI.Views.Pages"
	x:Name="RootPage"
	behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
	d:DataContext="{d:DesignInstance Type=viewmodels:EmailList_ViewModel}"
	NavigationCacheMode="Required"
	mc:Ignorable="d">

	<Page.Resources>
		<DataTemplate x:Key="CategoryTemplate" x:DataType="models:MailboxCategory">
			<Grid Height="60">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<FontIcon
					Grid.Column="0"
					VerticalAlignment="Center"
					FontFamily="Segoe MDL2 Assets"
					FontSize="26"
					Glyph="{x:Bind Icon}" />

				<TextBlock
					Grid.Column="1"
					Margin="12 0 0 0"
					VerticalAlignment="Center"
					Style="{StaticResource ListTitleStyle}"
					Text="{x:Bind Title}" />
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="MailItemTemplate" x:DataType="models:Email">
			<Grid Height="110" Margin="0 0 12 0">
				<Grid.ContextFlyout>
					<MenuFlyout>
						<!--  Favoris  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_Favorite"
							Command="{Binding DataContext.MarkAsStarredCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Icon="Favorite" />

						<!--  Marquer comme lu  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_MarkAsRead"
							Command="{Binding DataContext.MarkAsReadCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Icon="Accept" />

						<!--  Marquer comme non-lu  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_MarkAsUnread"
							Command="{Binding DataContext.MarkAsUnreadCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Icon="Undo" />

						<MenuFlyoutSeparator />

						<!--  Archiver  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_Archive"
							Command="{Binding DataContext.ArchiveMailCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Icon="Folder" />

						<!--  Restaurer  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_Restore"
							Command="{Binding DataContext.RestoreMailCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Foreground="LightGreen"
							Icon="Back" />

						<MenuFlyoutSeparator />

						<!--  Déplacement dans PhishingSpam  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_MoveToPhishingSpam"
							Command="{Binding DataContext.MoveMailToPhishingSpamCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Foreground="Orange"
							Icon="ReportHacked" />

						<!--  Sortie de PhishingSpam  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_RemoveFromPhishingSpam"
							Command="{Binding DataContext.RemoveMailFromPhishingSpamCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Foreground="LightGreen"
							Icon="Back" />

						<MenuFlyoutSeparator />

						<!--  Supprimer  -->
						<MenuFlyoutItem
							x:Uid="Email_Action_Delete"
							Command="{Binding DataContext.DeleteMailCommand, ElementName=RootPage}"
							CommandParameter="{Binding}"
							Foreground="IndianRed"
							Icon="Delete" />
					</MenuFlyout>
				</Grid.ContextFlyout>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<StackPanel
					Grid.Column="1"
					Margin="{StaticResource SmallLeftMargin}"
					VerticalAlignment="Center">
					<!--  Alignement SenderName / DateSent  -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<!--  Étoile  -->
						<FontIcon
							Grid.Column="0"
							Margin="0 0 6 0"
							FontFamily="Segoe MDL2 Assets"
							Foreground="Gold"
							Glyph="&#xE734;"
							Visibility="{x:Bind IsStarred}" />

						<TextBlock
							Grid.Column="1"
							FontWeight="{x:Bind IsRead, Converter={StaticResource BoolToFontWeight}}"
							Style="{StaticResource ListTitleItem_Style}"
							Text="{x:Bind SenderName}" />

						<TextBlock
							Grid.Column="2"
							Style="{StaticResource ListSubTitle_RightStyle}"
							Text="{x:Bind DisplayDateSent}" />
					</Grid>
					<TextBlock
						FontWeight="{x:Bind IsRead, Converter={StaticResource BoolToFontWeight}}"
						Style="{StaticResource ListSubTitleStyle}"
						Text="{x:Bind Subject}" />
					<TextBlock Style="{StaticResource ListSubTitleStyle}" Text="{x:Bind PreviewContent}" />
				</StackPanel>
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="DetailsMailsTemplate" x:DataType="models:Email">
			<Grid Margin="64 0 0 0">
				<views:EmailList_DetailsControl DetailsListMenuItem_Email="{x:Bind}" />
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="NoSelectionContentTemplate">
			<Grid>
				<TextBlock
					x:Uid="ListDetails_NoSelection"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Style="{ThemeResource SubtitleTextBlockStyle}"
					TextAlignment="Center" />
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="ListHeaderTemplate">
			<Grid Height="40">
				<TextBlock
					VerticalAlignment="Center"
					Style="{StaticResource ListTitleStyle}"
					Text="{Binding}" />
			</Grid>
		</DataTemplate>
		<DataTemplate x:Key="MinimalListHeaderTemplate">
			<Grid Height="40">
				<TextBlock
					Margin="96 0 0 0"
					VerticalAlignment="Center"
					Style="{StaticResource ListTitleStyle}"
					Text="{Binding}" />
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="CategoryDetailsTemplate" x:DataType="models:MailboxCategory">
			<controls:ListDetailsView
				Background="Transparent"
				BorderBrush="Transparent"
				DetailsTemplate="{StaticResource DetailsMailsTemplate}"
				ItemTemplate="{StaticResource MailItemTemplate}"
				ItemsSource="{x:Bind Items}"
				SelectedItem="{x:Bind SelectedEmail, Mode=TwoWay}"
				SelectionChanged="OnInnerListDetailsSelectionChanged" />
		</DataTemplate>
	</Page.Resources>

	<Grid x:Name="ContentArea" Margin="-56 0 0 0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<!--  Bouton d'envoi  -->
			<Button
				Grid.Column="0"
				Width="203"
				Height="40"
				Margin="58 8 16 32"
				Command="{x:Bind ViewModel.OpenNewMailCommand}">
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<FontIcon
						Margin="0 0 8 0"
						FontFamily="Segoe MDL2 Assets"
						Glyph="&#xE70F;" />
					<TextBlock x:Uid="NewMessageButton" />
				</StackPanel>
			</Button>

			<!--  Bouton de refresh des emails  -->
			<Button
				Grid.Column="1"
				Width="50"
				Height="40"
				Margin="0 8 16 32"
				Command="{x:Bind ViewModel.RefreshEmailListCommand}">
				<ToolTipService.ToolTip>
					<ToolTip x:Uid="Button_Refresh" />
				</ToolTipService.ToolTip>
				<FontIcon
					Margin="0 0 0 0"
					FontFamily="Segoe MDL2 Assets"
					FontSize="25"
					Glyph="&#xE895;" />
			</Button>

			<!--  Barre de recherche  -->
			<TextBox
				x:Uid="SearchbarMailTextBox"
				Grid.Column="2"
				Height="40"
				Margin="0 8 16 32"
				Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<!--  Contenu principal du bouton  -->
			<SplitButton
				Grid.Column="3"
				Width="200"
				Height="40"
				Margin="0 8 16 32">
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<FontIcon
						Margin="0 0 8 0"
						FontFamily="Segoe MDL2 Assets"
						Glyph="&#xE71C;" />
					<TextBlock x:Uid="AddFilterTextBlock" />
				</StackPanel>

				<!--  Menu déroulant du bouton  -->
				<SplitButton.Flyout>
					<MenuFlyout>
						<MenuFlyoutItem
							x:Uid="Filter_Date_Before"
							Command="{x:Bind ViewModel.DateBeforeFilterCommand}"
							Foreground="CornflowerBlue">
							<MenuFlyoutItem.Icon>
								<FontIcon
									Margin="0 0 0 0"
									FontFamily="Segoe MDL2 Assets"
									Glyph="&#xE787;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
						<MenuFlyoutItem
							x:Uid="Filter_Date_After"
							Command="{x:Bind ViewModel.DateAfterFilterCommand}"
							Foreground="LimeGreen">
							<MenuFlyoutItem.Icon>
								<FontIcon
									Margin="0 0 0 0"
									FontFamily="Segoe MDL2 Assets"
									Glyph="&#xE787;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>

						<MenuFlyoutSeparator />
						<MenuFlyoutItem
							x:Uid="Filter_Attachments_Yes"
							Command="{x:Bind ViewModel.AttachmentYesFilterCommand}"
							Foreground="MediumPurple">
							<MenuFlyoutItem.Icon>
								<FontIcon
									Margin="0 0 0 0"
									FontFamily="Segoe MDL2 Assets"
									Glyph="&#xE723;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
						<MenuFlyoutItem
							x:Uid="Filter_Attachments_No"
							Command="{x:Bind ViewModel.AttachmentNoFilterCommand}"
							Foreground="OrangeRed">
							<MenuFlyoutItem.Icon>
								<FontIcon
									Margin="0 0 0 0"
									FontFamily="Segoe MDL2 Assets"
									Glyph="&#xE723;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>

						<MenuFlyoutSeparator />
						<MenuFlyoutItem x:Uid="Filter_With_AI" Command="{x:Bind ViewModel.AI_FilterCommand}">
							<MenuFlyoutItem.Icon>
								<FontIcon
									Margin="0 0 0 0"
									FontFamily="Segoe MDL2 Assets"
									Glyph="&#xE99A;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
					</MenuFlyout>
				</SplitButton.Flyout>
			</SplitButton>

			<!--  Ce CalendarDatePicker est affiché uniquement lorsque l'utilisateur choisi un filtre DateBefore ou DateAfter  -->
			<CalendarDatePicker
				Grid.Column="3"
				Width="0"
				Height="0"
				Date="{x:Bind ViewModel.DatePicked, Mode=TwoWay}"
				IsCalendarOpen="{x:Bind ViewModel.IsDatePickerOpen, Mode=TwoWay}" />

			<!--  Bouton de l'onglet IA  -->
			<Button
				Grid.Column="4"
				Width="50"
				Height="200"
				Margin="0 50 -50 -170"
				Command="{x:Bind ViewModel.SubmitAICommand}">
				<ToolTipService.ToolTip>
					<ToolTip x:Uid="Button_AIinterface" />
				</ToolTipService.ToolTip>
				<FontIcon
					Margin="0 0 0 0"
					FontFamily="Segoe MDL2 Assets"
					FontSize="25"
					Glyph="&#xE99A;" />
			</Button>
		</Grid>

		<controls:ListDetailsView
			x:Name="ListDetailsViewControl"
			x:Uid="ListDetails"
			Grid.Row="1"
			BackButtonBehavior="Manual"
			Background="Transparent"
			BorderBrush="Transparent"
			DetailsTemplate="{StaticResource CategoryDetailsTemplate}"
			ItemContainerStyle="{StaticResource CategoryItemStyle}"
			ItemTemplate="{StaticResource CategoryTemplate}"
			ItemsSource="{x:Bind ViewModel.Categories}"
			ListHeaderTemplate="{StaticResource MinimalListHeaderTemplate}"
			NoSelectionContentTemplate="{StaticResource NoSelectionContentTemplate}"
			SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
			SelectionChanged="OnCategoryListDetailsSelectionChanged"
			ViewStateChanged="OnViewStateChanged" />
		<Grid
			Grid.Row="1"
			Width="41"
			Margin="272 0 0 0"
			HorizontalAlignment="Left"
			RowSpacing="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Button
				Grid.Row="0"
				Command="{x:Bind ViewModel.LoadPreviousMailsCommand}"
				IsEnabled="{Binding HasPreviousMails}">
				<ToolTipService.ToolTip>
					<ToolTip x:Uid="Button_LoadPreviousMails" />
				</ToolTipService.ToolTip>
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76B;" />
				</StackPanel>
			</Button>
			<Button
				Grid.Row="1"
				Command="{x:Bind ViewModel.LoadFollowingMailsCommand}"
				IsEnabled="{Binding HasFollowingMails}">
				<ToolTipService.ToolTip>
					<ToolTip x:Uid="Button_LoadFollowingMails" />
				</ToolTipService.ToolTip>
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" />
				</StackPanel>
			</Button>
			<Button
				Grid.Row="2"
				Command="{x:Bind ViewModel.DeleteAllMailsFromCurrentCategoryCommand}"
				Visibility="{x:Bind ViewModel.IsValideCategory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
				<ToolTipService.ToolTip>
					<ToolTip x:Uid="Button_DeleteAllMails" />
				</ToolTipService.ToolTip>
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" />
				</StackPanel>
			</Button>
			<Button
				Grid.Row="2"
				Command="{x:Bind ViewModel.MarkAsReadAllMailsFromCurrentCategoryCommand}"
				Visibility="{x:Bind ViewModel.IsUnreadCategory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
				<ToolTipService.ToolTip>
					<ToolTip x:Uid="Button_MarkAsReadAllMails" />
				</ToolTipService.ToolTip>
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" />
				</StackPanel>
			</Button>
		</Grid>
		<Grid
			x:Name="ComposeOverlay"
			Grid.Row="1"
			Width="{Binding ElementName=ListDetailsViewControl, Path=ActualWidth}"
			Height="{Binding ElementName=ListDetailsViewControl, Path=ActualHeight}"
			MaxWidth="{x:Bind ViewModel.ComposeMaxWidth, Mode=OneWay}"
			MaxHeight="{x:Bind ViewModel.ComposeMaxHeight, Mode=OneWay}"
			HorizontalAlignment="Right"
			VerticalAlignment="Bottom"
			Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
			CornerRadius="15"
			Visibility="{x:Bind ViewModel.IsComposing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<views:EmailList_NewMailControl />
		</Grid>
		<Grid
			x:Name="AIinterfaceOverlay"
			Grid.Row="1"
			Width="{Binding ElementName=ListDetailsViewControl, Path=ActualWidth}"
			MinWidth="350"
			MaxWidth="{x:Bind ViewModel.AIinterfaceMaxWidth, Mode=OneWay}"
			Margin="0 0 -5 0"
			HorizontalAlignment="Right"
			Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
			CornerRadius="15"
			Visibility="{x:Bind ViewModel.IsAIinterfaceVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<views:AIinterface_Control />
		</Grid>
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState>
					<VisualState.StateTriggers>
						<!--  641 is the default CompactModeThresholdWidth in NavigationView  -->
						<AdaptiveTrigger MinWindowWidth="641" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="ListDetailsViewControl.ListHeaderTemplate" Value="{StaticResource ListHeaderTemplate}" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
	</Grid>
</Page>