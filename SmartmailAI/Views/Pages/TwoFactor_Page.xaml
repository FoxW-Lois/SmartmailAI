<Page
	x:Class="SmartmailAI.Views.Pages.TwoFactor_Page"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="using:SmartmailAI.Behaviors"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="using:SmartmailAI.ViewModels.Pages"
	behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
	d:DataContext="{d:DesignInstance Type=viewmodels:TwoFactor_ViewModel}"
	NavigationCacheMode="Required"
	mc:Ignorable="d">

	<Grid
		x:Name="ContentArea"
		Width="360"
		HorizontalAlignment="Center"
		VerticalAlignment="Center">
		<StackPanel Spacing="26">
			<TextBlock
				x:Uid="Account_DoubleFactor"
				Style="{ThemeResource TitleTextBlockStyle}"
				TextWrapping="Wrap" />
			<TextBox
				x:Uid="Account_SecurityCode"
				InputScope="Number"
				MaxLength="6"
				Text="{x:Bind ViewModel.Code, Mode=TwoWay}" />

			<TextBlock
				Foreground="Red"
				Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
				TextWrapping="Wrap"
				Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

			<Button
				x:Uid="Account_Validate"
				HorizontalAlignment="Center"
				Command="{Binding ValidateCommand}" />
		</StackPanel>
	</Grid>
</Page>