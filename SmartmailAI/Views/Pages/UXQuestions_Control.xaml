<UserControl
	x:Class="SmartmailAI.Views.Pages.UXQuestions_Control"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="using:SmartmailAI.ViewModels.Pages"
	d:DataContext="{d:DesignInstance Type=viewmodels:UXQuestions_ViewModel}"
	mc:Ignorable="d">

	<Grid
		Width="750"
		MaxHeight="600"
		Padding="12"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch">
		<ScrollViewer>
			<StackPanel Margin="4" Spacing="16">
				<TextBlock x:Uid="UXQuestions_Title" Style="{ThemeResource TitleTextBlockStyle}" />
				<TextBlock
					x:Uid="UXQuestions_Description"
					Padding="0 0 0 24"
					Style="{ThemeResource DetailBodyBaseMediumStyle}" />

				<StackPanel Spacing="24">
					<!--  Nombre d'ouvertures  -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							x:Uid="UXQuestions_NbOpenAppByWeek"
							Grid.Row="0"
							Grid.Column="0"
							Margin="0 5 10 0"
							TextWrapping="Wrap" />

						<NumberBox
							Grid.Row="0"
							Grid.Column="1"
							Width="240"
							HorizontalAlignment="Right"
							AcceptsExpression="False"
							Maximum="100"
							Minimum="0"
							SmallChange="3"
							SpinButtonPlacementMode="Inline"
							Value="{x:Bind ViewModel.NbOpenAppByWeek, Mode=TwoWay}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Foreground="Red"
							Text="{x:Bind ViewModel.ErrorMessage1, Mode=OneWay}"
							TextWrapping="Wrap"
							Visibility="{x:Bind ViewModel.ErrorVisibility1, Mode=OneWay}" />
					</Grid>

					<!--  Trafic quotidien  -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							x:Uid="UXQuestions_AverageDailyTrafic"
							Grid.Row="0"
							Grid.Column="0"
							Margin="0 -5 10 0"
							TextWrapping="Wrap" />

						<ComboBox
							Grid.Row="0"
							Grid.Column="1"
							Width="240"
							ItemsSource="{x:Bind ViewModel.AverageDailyTraficOptions}"
							SelectedItem="{x:Bind ViewModel.SelectedAverageDailyTrafic, Mode=TwoWay}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Foreground="Red"
							Text="{x:Bind ViewModel.ErrorMessage2, Mode=OneWay}"
							TextWrapping="Wrap"
							Visibility="{x:Bind ViewModel.ErrorVisibility2, Mode=OneWay}" />
					</Grid>

					<!--  Récupération emails  -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock
							x:Uid="UXQuestions_RetrievedAllEmailsFromFuturesAddresses"
							Grid.Column="0"
							Margin="0 -5 10 0"
							VerticalAlignment="Top"
							TextWrapping="Wrap" />
						<ToggleSwitch
							x:Name="RetrievedAllEmailsFromFuturesAddressesCheckbox"
							Grid.Column="1"
							Width="240"
							IsOn="{x:Bind ViewModel.RetrievedAllEmails, Mode=TwoWay}" />
					</Grid>

					<!--  Date récupération emails  -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							x:Uid="UXQuestions_CalendarDatePicker"
							Grid.Row="0"
							Grid.Column="0"
							Margin="0 5 10 0"
							VerticalAlignment="Top"
							TextWrapping="Wrap"
							Visibility="{x:Bind ViewModel.RetrievedAllEmails, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

						<CalendarDatePicker
							x:Name="DateEmailsWereRetrievedPicker"
							x:Uid="UXQuestions_DateEmailsWereRetrieved"
							Grid.Row="0"
							Grid.Column="1"
							Width="240"
							HorizontalAlignment="Right"
							Date="{x:Bind ViewModel.DatePicked, Mode=TwoWay}"
							Visibility="{x:Bind ViewModel.RetrievedAllEmails, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Foreground="Red"
							Text="{x:Bind ViewModel.ErrorMessage3, Mode=OneWay}"
							TextWrapping="Wrap"
							Visibility="{x:Bind ViewModel.ErrorVisibility3, Mode=OneWay}" />
					</Grid>
				</StackPanel>

				<Button
					x:Uid="Account_Validate"
					HorizontalAlignment="Right"
					Click="OnValidateClicked"
					FontSize="16" />
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>