<Page
	x:Class="SmartmailAI.Views.Pages.AddressManagement_Page"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="using:SmartmailAI.Behaviors"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:SmartmailAI.Core.Models"
	xmlns:viewmodels="using:SmartmailAI.ViewModels.Pages"
	behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
	d:DataContext="{d:DesignInstance Type=viewmodels:AddressManagement_ViewModel}"
	NavigationCacheMode="Required"
	mc:Ignorable="d">

	<Grid x:Name="ContentArea">
		<ItemsRepeater ItemsSource="{x:Bind ViewModel.AccountsMail, Mode=OneWay}">
			<ItemsRepeater.ItemTemplate>
				<DataTemplate x:DataType="models:AccountGmail">
					<Border Margin="4" Padding="8">
						<Grid HorizontalAlignment="Center" ColumnSpacing="52">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0" Text="{x:Bind Email}" />
							<StackPanel
								Grid.Column="1"
								Orientation="Horizontal"
								Spacing="2">
								<TextBlock x:Uid="ManagementAddress_DateInfo" />
								<TextBlock Text="{x:Bind ConnectedAt}" />
							</StackPanel>

							<Button
								x:Uid="ManagementAddress_Delete"
								Grid.Column="2"
								Click="OnAddressDeleteClicked"
								CommandParameter="{x:Bind}"
								FontSize="14"
								Foreground="Red" />
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsRepeater.ItemTemplate>
		</ItemsRepeater>
	</Grid>
</Page>