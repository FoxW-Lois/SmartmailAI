<UserControl
	x:Class="SmartmailAI.Views.Pages.AIinterface_Control"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:SmartmailAI.Core.Models.AI"
	mc:Ignorable="d">

	<Grid
		Height="660"
		Padding="12"
		RowSpacing="12">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<Grid Grid.Row="0" VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				x:Uid="AI_AssistantName"
				Grid.Column="1"
				VerticalAlignment="Center"
				FontSize="18"
				FontWeight="SemiBold" />

			<!--  Actions secondaires  -->
			<StackPanel
				Grid.Column="2"
				Orientation="Horizontal"
				Spacing="8">

				<!--  Supprimer  -->
				<Button Command="{x:Bind ViewModel.DeleteCommand}">
					<ToolTipService.ToolTip>
						<ToolTip x:Uid="Button_Delete" />
					</ToolTipService.ToolTip>
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" />
				</Button>

				<!--  Fermer/cacher  -->
				<Button Command="{x:Bind ViewModel.DiscardCommand}">
					<ToolTipService.ToolTip>
						<ToolTip x:Uid="Button_Hide" />
					</ToolTipService.ToolTip>
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE921;" />
				</Button>

				<!--  Ouvrir en plein écran  -->
				<Button Command="{x:Bind ViewModel.ExpandCommand}">
					<ToolTipService.ToolTip>
						<ToolTip x:Uid="Button_Expand" />
					</ToolTipService.ToolTip>
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;" />
				</Button>
			</StackPanel>
		</Grid>

		<ListView
			x:Name="ConversationList"
			Grid.Row="1"
			Height="510"
			IsItemClickEnabled="False"
			IsTabStop="False"
			ItemsSource="{x:Bind ViewModel.Conversation}"
			SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="models:AIMessage">
					<Grid Margin="0 0 0 12">
						<Border
							MaxWidth="600"
							Padding="16 12"
							HorizontalAlignment="{Binding Alignment}"
							Background="{Binding BubbleBrush}"
							CornerRadius="18">
							<TextBlock
								IsTextSelectionEnabled="True"
								Text="{Binding Content}"
								TextWrapping="Wrap" />
						</Border>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<!--  Zone de saisie  -->
		<Border
			Grid.Row="2"
			Padding="8 8 8 12"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			CornerRadius="12">

			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!--  Saisie des prompts  -->
				<TextBox
					x:Uid="AddPromptPlaceholder"
					Grid.Column="0"
					MinHeight="40"
					MaxHeight="120"
					Margin="0 4 0 0"
					AcceptsReturn="True"
					BorderThickness="0 0 0 1"
					PlaceholderText=""
					Text="{x:Bind ViewModel.UserPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="Wrap" />

				<!--  Bouton Envoyer  -->
				<Button
					Grid.Column="1"
					Width="40"
					Height="40"
					Margin="0 0 0 -4"
					Command="{x:Bind ViewModel.SendPromptCommand}"
					Style="{StaticResource AccentButtonStyle}">
					<ToolTipService.ToolTip>
						<ToolTip x:Uid="Button_Send" />
					</ToolTipService.ToolTip>
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE724;" />
				</Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>