<Page
	x:Class="SmartmailAI.Views.Pages.NavShell_Page"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="using:SmartmailAI.Behaviors"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:SmartmailAI.Helpers.Navigation"
	xmlns:i="using:Microsoft.Xaml.Interactivity"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:SmartmailAI.Core.Models"
	xmlns:viewmodels="using:SmartmailAI.ViewModels.Pages"
	d:DataContext="{d:DesignInstance Type=viewmodels:NavShell_ViewModel}"
	Loaded="Page_Loaded"
	NavigationCacheMode="Required"
	mc:Ignorable="d">

	<Grid x:Name="ContentArea">
		<Grid
			x:Name="AppTitleBar"
			Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
			VerticalAlignment="Top"
			Canvas.ZIndex="1"
			IsHitTestVisible="True">
			<Image
				Width="16"
				Height="16"
				HorizontalAlignment="Left"
				Source="ms-appx:///Assets/Icon.ico" />
			<TextBlock
				x:Name="AppTitleBarText"
				Margin="28 0 0 0"
				VerticalAlignment="Center"
				Style="{StaticResource CaptionTextBlockStyle}"
				TextWrapping="NoWrap" />
		</Grid>
		<NavigationView
			x:Name="NavigationViewControl"
			Canvas.ZIndex="0"
			CompactPaneLength="48"
			DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
			ExpandedModeThresholdWidth="1280"
			Header="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}"
			IsBackButtonVisible="Visible"
			IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
			IsSettingsVisible="True"
			ItemInvoked="NavigationView_ItemInvoked"
			OpenPaneLength="200"
			SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
			<NavigationView.MenuItems>

				<NavigationViewItem
					x:Uid="Shell_Login"
					helpers:NavigationHelper.NavigateTo="SmartmailAI.ViewModels.Pages.Login_ViewModel"
					Visibility="{Binding IsNotLogged, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE77B;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					x:Uid="Shell_Logout"
					SelectsOnInvoked="False"
					Tag="Logout"
					Visibility="{Binding IsLogged, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E8;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					x:Uid="Shell_Register"
					helpers:NavigationHelper.NavigateTo="SmartmailAI.ViewModels.Pages.Register_ViewModel"
					Visibility="{Binding IsNotLogged, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8FA;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					x:Uid="Shell_Home"
					helpers:NavigationHelper.NavigateTo="SmartmailAI.ViewModels.Pages.Home_ViewModel"
					Visibility="{Binding IsLogged, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<!--  TODO: Si besoin d'utiliser des données statiques, décommenter l'Item ↓  -->
				<!--<NavigationViewItem
					x:Uid="Shell_DetailsList"
					helpers:NavigationHelper.NavigateTo="SmartmailAI.ViewModels.Pages.DetailsList_ViewModel"
					Visibility="{Binding IsLogged, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xea37;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>-->

				<NavigationViewItem
					x:Uid="Shell_MailAddresses"
					MenuItemsSource="{Binding AccountsGmail}"
					Visibility="{Binding IsLogged, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.MenuItems>
						<DataTemplate x:DataType="models:AccountGmail">
							<NavigationViewItem Content="{x:Bind Email}" Tag="{x:Bind}" />
						</DataTemplate>
					</NavigationViewItem.MenuItems>

					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE715;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					x:Uid="Shell_AddAddress"
					helpers:NavigationHelper.NavigateTo="SmartmailAI.ViewModels.Pages.AddAddress_ViewModel"
					Visibility="{Binding IsLogged, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE710;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					x:Uid="Shell_AddressManagement"
					helpers:NavigationHelper.NavigateTo="SmartmailAI.ViewModels.Pages.AddressManagement_ViewModel"
					Visibility="{Binding CanShowAddressManagement, Converter={StaticResource BoolToVisibilityConverter}}">
					<NavigationViewItem.Icon>
						<FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE779;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.MenuItems>

			<NavigationView.HeaderTemplate>
				<DataTemplate>
					<Grid>
						<TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
					</Grid>
				</DataTemplate>
			</NavigationView.HeaderTemplate>

			<i:Interaction.Behaviors>
				<behaviors:NavigationViewHeaderBehavior DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
					<behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
						<DataTemplate>
							<Grid>
								<TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
							</Grid>
						</DataTemplate>
					</behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
				</behaviors:NavigationViewHeaderBehavior>
			</i:Interaction.Behaviors>
			<Grid Margin="{StaticResource NavigationViewPageContentMargin}">
				<Frame x:Name="NavigationFrame" />
			</Grid>
		</NavigationView>
	</Grid>
</Page>