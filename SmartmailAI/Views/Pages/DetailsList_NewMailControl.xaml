<UserControl
	x:Class="SmartmailAI.Views.Pages.DetailsList_NewMailControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:SmartmailAI.Core.Models"
	x:Name="RootControl"
	mc:Ignorable="d">

	<Grid
		MinHeight="410"
		Padding="12"
		RowSpacing="8">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Toolbar  -->
		<Grid Grid.Row="0" VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!--  Bouton Envoyer  -->
			<Button
				x:Uid="ButtonSend"
				Grid.Column="0"
				Command="{x:Bind ViewModel.SendCommand}"
				Foreground="White"
				Style="{StaticResource AccentButtonStyle}" />

			<!--  Pièces jointes  -->
			<Button
				Grid.Column="1"
				Margin="8 0 0 0"
				Command="{x:Bind ViewModel.AttachFileCommand}">
				<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE723;" />
			</Button>

			<!--  Actions secondaires  -->
			<StackPanel
				Grid.Column="3"
				Orientation="Horizontal"
				Spacing="8">

				<!--  Supprimer  -->
				<Button Command="{x:Bind ViewModel.DiscardCommand}">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" />
				</Button>

				<!--  Brouillon  -->
				<Button Command="{x:Bind ViewModel.DraftedCommand}">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C3;" />
				</Button>

				<!--  Ouvrir en plein écran  -->
				<Button Command="{x:Bind ViewModel.ExpandCommand}">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;" />
				</Button>
			</StackPanel>
		</Grid>

		<!--  Ligne À  -->
		<Grid Grid.Row="1" VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				x:Uid="ToTextBlock"
				Grid.Column="0"
				Width="40"
				VerticalAlignment="Center" />

			<TextBox
				x:Uid="RecipientsTextBox"
				Grid.Column="1"
				BorderThickness="0 0 0 1"
				Text="{x:Bind ViewModel.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<Button
				x:Uid="ButtonCc"
				Grid.Column="2"
				Command="{x:Bind ViewModel.ToggleCcCommand}" />

			<Button
				x:Uid="ButtonBcc"
				Grid.Column="3"
				Command="{x:Bind ViewModel.ToggleBccCommand}" />
		</Grid>

		<!--  Ligne Cc & Bcc  -->
		<Grid
			Grid.Row="2"
			VerticalAlignment="Center"
			ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  Cc  -->
			<Grid
				Grid.Column="0"
				HorizontalAlignment="Stretch"
				Visibility="{x:Bind ViewModel.IsCcVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock
					x:Uid="CcTextBlock"
					Grid.Column="0"
					Width="25"
					VerticalAlignment="Center" />

				<TextBox
					Grid.Column="1"
					BorderThickness="0 0 0 1"
					Text="{x:Bind ViewModel.Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			</Grid>

			<!--  Bcc  -->
			<Grid
				Grid.Column="1"
				HorizontalAlignment="Stretch"
				Visibility="{x:Bind ViewModel.IsBccVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock
					x:Uid="BccTextBlock"
					Grid.Column="0"
					Width="25"
					VerticalAlignment="Center" />

				<TextBox
					Grid.Column="1"
					BorderThickness="0 0 0 1"
					Text="{x:Bind ViewModel.Bcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			</Grid>
		</Grid>

		<!--  Objet  -->
		<TextBox
			x:Uid="AddSubjectTextBox"
			Grid.Row="3"
			BorderThickness="0 0 0 1"
			IsEnabled="{x:Bind ViewModel.IsSubjectEnable, Mode=OneWay}"
			Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<!--  Liste des pièces jointes  -->
		<ItemsRepeater
			Grid.Row="4"
			ItemsSource="{x:Bind ViewModel.Attachments, Mode=OneWay}"
			Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<ItemsRepeater.Layout>
				<StackLayout Orientation="Horizontal" Spacing="8" />
			</ItemsRepeater.Layout>
			<ItemsRepeater.ItemTemplate>
				<DataTemplate x:DataType="models:MailAttachment">
					<Grid
						Padding="8 4"
						Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
						CornerRadius="4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<FontIcon
							Grid.Column="0"
							Margin="0 0 6 0"
							FontFamily="Segoe MDL2 Assets"
							FontSize="14"
							Glyph="&#xE723;" />
						<TextBlock
							Grid.Column="1"
							VerticalAlignment="Center"
							Text="{x:Bind FileName}" />
						<Button
							Grid.Column="2"
							Margin="6 0 0 0"
							Padding="4"
							Click="OnRemoveAttachmentClick"
							Tag="{x:Bind}">
							<FontIcon
								FontFamily="Segoe MDL2 Assets"
								FontSize="10"
								Glyph="&#xE711;" />
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsRepeater.ItemTemplate>
		</ItemsRepeater>

		<!--  Corps  -->
		<RichEditBox
			x:Name="BodyEditor"
			x:Uid="MessageAreaRichEditBox"
			Grid.Row="5"
			Margin="0 8 0 0"
			BorderThickness="0"
			TextChanged="OnBodyChanged" />
	</Grid>
</UserControl>