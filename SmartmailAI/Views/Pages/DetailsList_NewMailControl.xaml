<UserControl
	x:Class="SmartmailAI.Views.Pages.DetailsList_NewMailControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="RootControl"
	mc:Ignorable="d">

	<Grid
		MinHeight="480"
		Padding="12"
		RowSpacing="8">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Toolbar  -->
		<Grid Grid.Row="0" VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!--  Bouton Envoyer  -->
			<Button
				x:Uid="ButtonSend"
				Grid.Column="0"
				Command="{x:Bind ViewModel.SendCommand}"
				Foreground="White"
				Style="{StaticResource AccentButtonStyle}" />

			<!--  Actions secondaires  -->
			<StackPanel
				Grid.Column="2"
				Orientation="Horizontal"
				Spacing="8">

				<!--  Supprimer  -->
				<Button Command="{x:Bind ViewModel.DiscardCommand}">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" />
				</Button>

				<!--  Ouvrir en plein écran  -->
				<Button Command="{x:Bind ViewModel.ExpandCommand}">
					<FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;" />
				</Button>
			</StackPanel>
		</Grid>

		<!--  Ligne À  -->
		<Grid Grid.Row="1" VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				x:Uid="ToTextBlock"
				Grid.Column="0"
				Width="40"
				VerticalAlignment="Center" />

			<TextBox
				x:Uid="RecipientsTextBox"
				Grid.Column="1"
				BorderThickness="0 0 0 1"
				Text="{x:Bind ViewModel.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<Button
				x:Uid="ButtonBcc"
				Grid.Column="2"
				Command="{x:Bind ViewModel.ToggleBccCommand}" />
		</Grid>

		<!--  Ligne Cc  -->
		<Grid Grid.Row="2" VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<TextBlock
				x:Uid="CcTextBlock"
				Grid.Column="0"
				Width="40"
				VerticalAlignment="Center" />

			<TextBox
				Grid.Column="1"
				BorderThickness="0 0 0 1"
				Text="{x:Bind ViewModel.Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>

		<!--  Objet  -->
		<TextBox
			x:Uid="AddSubjectTextBox"
			Grid.Row="3"
			BorderThickness="0 0 0 1"
			Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<!--  Corps  -->
		<ScrollViewer
			Grid.Row="4"
			Margin="0 8 0 0"
			VerticalScrollMode="Enabled">
			<RichEditBox
				x:Name="BodyEditor"
				x:Uid="MessageAreaRichEditBox"
				MinHeight="200"
				BorderThickness="0"
				TextChanged="OnBodyChanged" />
		</ScrollViewer>
	</Grid>
</UserControl>