<UserControl
	x:Class="SmartmailAI.Views.Pages.DetailsList_DetailControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<ScrollViewer
		Name="ForegroundElement"
		HorizontalAlignment="Stretch"
		IsTabStop="True"
		VerticalScrollMode="Enabled">
		<StackPanel HorizontalAlignment="Left">
			<StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
				<Ellipse Width="36" Height="36">
					<Ellipse.Fill>
						<ImageBrush ImageSource="{x:Bind DetailsListMenuItem_Email.SenderProfileImageSource, Mode=OneWay}" Stretch="UniformToFill" />
					</Ellipse.Fill>
				</Ellipse>
				<TextBlock
					Margin="{StaticResource SmallLeftMargin}"
					VerticalAlignment="Center"
					Style="{ThemeResource TitleTextBlockStyle}"
					Text="{x:Bind DetailsListMenuItem_Email.SenderName, Mode=OneWay}" />
			</StackPanel>
			<StackPanel Padding="0 15 0 0">
				<TextBlock Style="{StaticResource DetailSubTitleStyle}" Text="Expéditeur" />
				<TextBlock Style="{StaticResource DetailBodyBaseMediumStyle}" Text="{x:Bind DetailsListMenuItem_Email.SenderEmail, Mode=OneWay}" />

				<TextBlock
					Margin="{StaticResource MediumTopMargin}"
					Style="{StaticResource DetailSubTitleStyle}"
					Text="Réceptionnaire" />
				<TextBlock Style="{StaticResource DetailBodyBaseMediumStyle}">
					<Run Text="À (vous) : " />
					<Run Text="{x:Bind DetailsListMenuItem_Email.ReceiverEmails, Mode=OneWay}" />
				</TextBlock>

				<TextBlock
					Margin="{StaticResource MediumTopMargin}"
					Style="{StaticResource DetailSubTitleStyle}"
					Text="Date d'envoi" />
				<TextBlock Style="{StaticResource DetailBodyBaseMediumStyle}" Text="{x:Bind DetailsListMenuItem_Email.DateSent, Mode=OneWay}" />

				<TextBlock
					Margin="{StaticResource MediumTopMargin}"
					Style="{StaticResource DetailSubTitleStyle}"
					Text="Objet" />
				<TextBlock Style="{StaticResource DetailBodyBaseMediumStyle}" Text="{x:Bind DetailsListMenuItem_Email.Subject, Mode=OneWay}" />

				<TextBlock
					Margin="{StaticResource LargeTopMargin}"
					Style="{StaticResource DetailBodyStyle}"
					Text="{x:Bind DetailsListMenuItem_Email.Content, Mode=OneWay}" />

				<TextBlock
					Margin="{StaticResource LargeTopMargin}"
					Style="{StaticResource DetailSubTitleStyle}"
					Text="Pièces jointes" />
				<TextBlock
					Margin="{StaticResource MediumBottomMargin}"
					Style="{StaticResource DetailBodyBaseMediumStyle}"
					Text="{x:Bind DetailsListMenuItem_Email.AttachmentsDisplay, Mode=OneWay}" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
